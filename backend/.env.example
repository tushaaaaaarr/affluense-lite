# Google Gemini through its OpenAI-compatible API
AFF_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=replace-with-your-google-ai-studio-key
AFF_MODEL=gemini-3.5-flash-lite
AFF_REASONING_EFFORT=

# HTTP Basic credentials for viewing/downloading run and cost logs
LOGS_USERNAME=logs-user
LOGS_PASSWORD=replace-with-a-private-password

