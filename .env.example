# Copy this file to .env and fill in your key. .env is in .gitignore, so it never gets committed.

# Option A: Google Gemini (free tier works), through its OpenAI-compatible endpoint
AFF_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your-gemini-key
AFF_MODEL=gemini-3.5-flash-lite
# only for "thinking" models such as gemini-3.5-flash; leave empty for flash-lite
AFF_REASONING_EFFORT=

# Option B: Anthropic
# AFF_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
